  "cli": {
    "version": ">= 7.0.0",
    "requireCommit": false,
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://complications-aspects-atmosphere-pts.trycloudflare.com/api",
        "EXPO_PUBLIC_ANDROID_API_HOST": "https://complications-aspects-atmosphere-pts.trycloudflare.com"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://complications-aspects-atmosphere-pts.trycloudflare.com/api",
        "EXPO_PUBLIC_ANDROID_API_HOST": "https://complications-aspects-atmosphere-pts.trycloudflare.com"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://complications-aspects-atmosphere-pts.trycloudflare.com/api",
        "EXPO_PUBLIC_ANDROID_API_HOST": "https://complications-aspects-atmosphere-pts.trycloudflare.com"
